"""A4988 choppers pulling 1.5 A at ~25 kHz from VMOT: ripple seen by the drivers and the buck input."""
load("@stdlib/properties.zen", "Simulation")
PowerInput = Module("PowerInput.zen")

GND = Ground()
BAT_P = Net("BAT_P")
VMOT = Net("VMOT")
VBAT_SENSE = Net("VBAT_SENSE")
PowerInput(name="PWR", BAT_P=BAT_P, GND=GND, VMOT=VMOT, VBAT_SENSE=VBAT_SENSE)

Simulation(
    name="SIM",
    setup="""
V_CELL BRAW GND DC 11.1
R_PACK BRAW BAT_P_L 0.06
L_LEAD BAT_P_L BAT_P 300n
I_BUCK VMOT GND 0.3
* worst case: both drivers chopping in phase, 0 -> 1.5 A square at 25 kHz, 100 ns edges
I_CHOP VMOT GND PULSE(0 1.5 2m 100n 100n 20u 40u)
.control
  tran 0.1u 6m
  meas tran vmot_pp PP v(VMOT) FROM=4m TO=6m
  meas tran vmot_min MIN v(VMOT) FROM=4m TO=6m
  meas tran vsense_pp PP v(VBAT_SENSE) FROM=4m TO=6m
.endc
""",
)
