"""Battery plugged in backwards (-12.6 V): VMOT must stay near 0 V and no large current may flow."""
load("@stdlib/properties.zen", "Simulation")
PowerInput = Module("PowerInput.zen")

GND = Ground()
BAT_P = Net("BAT_P")
VMOT = Net("VMOT")
VBAT_SENSE = Net("VBAT_SENSE")
PowerInput(name="PWR", BAT_P=BAT_P, GND=GND, VMOT=VMOT, VBAT_SENSE=VBAT_SENSE)

Simulation(
    name="SIM",
    setup="""
V_CELL BRAW GND PWL(0 0 1m 0 1.01m -12.6)
R_PACK BRAW BAT_P 0.06
* loads seen as resistances (an unpowered buck / drivers do not sink current by themselves)
R_LOAD VMOT GND 40
.control
  tran 2u 20m
  meas tran vmot_rev MIN v(VMOT) FROM=1m TO=20m
  let ibat = -i(V_CELL)
  meas tran ibat_rev MAX ibat FROM=1.5m TO=20m
  meas tran ibat_rev_min MIN ibat FROM=1.5m TO=20m
  meas tran vsense_rev MIN v(VBAT_SENSE) FROM=1m TO=20m
  let vgs = v(PWR.RPP_GATE)-v(PWR.VBAT_P)
  meas tran vgs_rev FIND vgs AT=19m
.endc
""",
)
